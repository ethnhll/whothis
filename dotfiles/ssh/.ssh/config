Include ~/.colima/ssh_config

# Ad-hoc/lab host configs. ~/.ssh/hosts.d lives outside this repo (real
# directory, not stowed), so one-off or ephemeral hosts (and their IPs)
# never end up in git. Drop/remove a file per host; deleting one has no
# effect on this file. Not created automatically - mkdir it once:
#   mkdir -p ~/.ssh/hosts.d
Include ~/.ssh/hosts.d/*

Host github.com
  HostName github.com

